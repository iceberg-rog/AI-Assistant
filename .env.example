# Shelter Support AI — copy this file to ".env" and fill in the values. NEVER commit the real .env.
#   cp .env.example .env   &&   nano .env

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather. The bot is added to your support account via
# Settings → Telegram Business → Chatbots (the account must have Telegram Premium).
TELEGRAM_BOT_TOKEN=

# Anthropic (Claude) API key. The bot re-checks low-confidence Persian messages with Claude.
# Without it, the system still runs but regex-only (weaker on ambiguous messages).
CLAUDE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# REAL DATA SOURCES (read-only endpoints) — needed for truthful answers
# ─────────────────────────────────────────────────────────────────────────────

# Live whitelist of registered customer IPs (getallips). Used to answer "is my IP registered?".
IP_REGISTRY_ALLIPS_URL=

# Read-only users DB query endpoint (subscription + registered IP by telegram_id).
USERS_QUERY_BASE=

# ─────────────────────────────────────────────────────────────────────────────
# MODEL — tiered brain: cheap haiku first, sonnet only on hard/low-confidence cases
# ─────────────────────────────────────────────────────────────────────────────
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────

# Telegram chat id to ping when a message is escalated to a human (e.g. your own chat with the bot).
ADMIN_CHAT_ID=

# Send mode. Leave "false" (Copilot / draft-only) until you trust the drafts. true = auto-reply.
SHELTER_AUTO_SEND=false

# Confidence floor: below this the message goes to Claude; still low → escalate to a human.
SHELTER_CONF_FLOOR=0.7
# Below this fast-model confidence, escalate to the smart model.
SHELTER_FAST_TRUST=0.78
# A user returning after this many hours starts a fresh conversation (stale context isn't reused).
SHELTER_SESSION_GAP_HOURS=6
